{
  "name": "console-plugin-template",
  "version": "0.0.1",
  "description": "Template project for OpenShift Console plugins",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openshift/console-plugin-template.git"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "yarn clean && NODE_ENV=production rspack",
    "build-dev": "yarn clean && rspack",
    "start": "rspack serve",
    "start-console": "./start-console.sh",
    "i18n": "i18next-cli lint && i18next-cli extract",
    "test": "LANG=en_US.UTF-8 jest",
    "lint": "eslint src integration-tests --fix --max-warnings 0 && stylelint 'src/**/*.css' --allow-empty-input --fix",
    "test-e2e": "playwright test --headed",
    "test-e2e-headless": "playwright test"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk": "4.23.0",
    "@openshift-console/dynamic-plugin-sdk-webpack": "4.23.0",
    "@patternfly/react-core": "^6.7.0",
    "@patternfly/react-icons": "^6.7.0",
    "@patternfly/react-table": "^6.7.0",
    "@playwright/browser-chromium": "~1.64.1",
    "@playwright/test": "~1.64.1",
    "@rspack/cli": "^2.2.9",
    "@rspack/core": "^2.2.9",
    "@rspack/dev-server": "^2.2.1",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.13.0",
    "i18next": "^26.5.3",
    "i18next-cli": "1.77.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-junit": "^17.0.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "^19.3.1",
    "react-i18next": "~17.1.0",
    "react-router": "~8.5.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "ts-checker-rspack-plugin": "^1.7.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0"
  },
  "dependenciesMeta": {
    "@playwright/browser-chromium": {
      "built": true
    }
  },
  "resolutions": {
    "immutable": "^4.3.9",
    "brace-expansion@^2.0.2": "^2.1.4"
  },
  "consolePlugin": {
    "name": "console-plugin-template",
    "version": "0.0.1",
    "displayName": "OpenShift Console Plugin Template",
    "description": "Template project for OpenShift Console plugins. Edit package.json to change this message and the plugin name.",
    "exposedModules": {
      "ExamplePage": "./components/ExamplePage"
    },
    "dependencies": {
      "@console/pluginAPI": ">=5.0.0-0 || >=4.23.0-0"
    }
  },
  "packageManager": "yarn@4.17.1"
}
